{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CtrlAltDelegate Worker Result V5.9.2",
  "type": "object",
  "required": [
    "job_id",
    "attempt_id",
    "status",
    "baseline_sha",
    "candidate_sha",
    "changed_files",
    "skills_applied",
    "gate_claims"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DONE",
        "BLOCKED",
        "FAILED"
      ]
    },
    "baseline_sha": {
      "type": "string"
    },
    "candidate_sha": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_claims": {
      "type": "array"
    },
    "research_drift": {
      "enum": [
        "NONE",
        "LOCAL_DETAIL",
        "JOB_CONTRACT",
        "STRATEGIC"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
